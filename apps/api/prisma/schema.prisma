generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum CollaboratorRole {
  editor
  viewer
}

enum ExpenseCategory {
  transport
  stay
  activities
  meals
  other
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkUserId  String   @unique
  email        String   @unique @db.VarChar(255)
  name         String?  @db.VarChar(100)
  photoUrl     String?
  languagePref String   @default("en") @db.VarChar(10)
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @db.Timestamptz

  trips          Trip[]
  expenses       TripExpense[]       @relation("ExpensePayer")
  collaborations TripCollaborator[]
}

model City {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  country    String   @db.VarChar(100)
  region     String?  @db.VarChar(100)
  costIndex  Decimal? @db.Decimal(5, 2)
  popularity Int      @default(0)
  lat        Decimal? @db.Decimal(9, 6)
  lng        Decimal? @db.Decimal(9, 6)
  imageUrl   String?

  activities Activity[]
  stops      TripStop[]

  @@unique([name, country])
}

model Activity {
  id          Int      @id @default(autoincrement())
  cityId      Int
  name        String   @db.VarChar(150)
  category    String?  @db.VarChar(50)
  description String?
  cost        Decimal  @default(0) @db.Decimal(10, 2)
  durationHrs Decimal? @db.Decimal(4, 1)
  imageUrl    String?

  city           City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  stopActivities StopActivity[]

  @@index([cityId])
  @@index([category])
}

model Trip {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  name        String   @db.VarChar(150)
  description String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  coverPhoto  String?
  budgetLimit Decimal? @db.Decimal(10, 2)
  isPublic    Boolean  @default(false)
  shareToken  String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops         TripStop[]
  expenses      TripExpense[]
  collaborators TripCollaborator[]
  checklist     TripChecklistItem[]
  versions      TripVersion[]

  @@index([userId])
}

model TripStop {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId     String   @db.Uuid
  cityId     Int
  orderIndex Int
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date

  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city       City           @relation(fields: [cityId], references: [id])
  activities StopActivity[]

  @@index([tripId, orderIndex])
}

model StopActivity {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stopId        String    @db.Uuid
  activityId    Int
  scheduledDate DateTime? @db.Date
  scheduledTime DateTime? @db.Time
  customCost    Decimal?  @db.Decimal(10, 2)
  notes         String?

  stop     TripStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id])

  @@index([stopId])
}

model TripExpense {
  id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId   String          @db.Uuid
  category ExpenseCategory
  amount   Decimal         @db.Decimal(10, 2)
  paidBy   String?         @db.Uuid
  note     String?

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer User? @relation("ExpensePayer", fields: [paidBy], references: [id])
}

model TripCollaborator {
  tripId String           @db.Uuid
  userId String           @db.Uuid
  role   CollaboratorRole @default(editor)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tripId, userId])
}

model TripChecklistItem {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String  @db.Uuid
  item      String? @db.VarChar(150)
  isChecked Boolean @default(false)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId       String   @db.Uuid
  snapshotJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}